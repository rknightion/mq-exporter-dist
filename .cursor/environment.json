{
  "build": {
    "dockerfile": "Dockerfile"
  },
  "user": "ubuntu",
  "install": "GOPROXY=https://proxy.golang.org GOWORK=off PIP_INDEX_URL=https://pypi.org/simple just cloud-bootstrap </dev/null",
  "egressMode": "network_settings_only",
  "egressAllowlist": [
    "archive.ubuntu.com",
    "security.ubuntu.com",
    "ports.ubuntu.com",
    "github.com",
    "release-assets.githubusercontent.com",
    "proxy.golang.org",
    "storage.googleapis.com",
    "sum.golang.org",
    "pypi.org",
    "files.pythonhosted.org"
  ]
}

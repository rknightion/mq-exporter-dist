{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "packageRules": [{
    "matchDatasources": ["docker"],
    "matchPackageNames": ["almalinux"],
    "allowedVersions": "<10"
  }, {
    "matchDatasources": ["rpm"],
    "matchPackageNames": ["rpm-build"],
    "registryUrls": ["https://cdn-ubi.redhat.com/content/public/ubi/dist/ubi8/8/x86_64/appstream/os/repodata/"],
    "versioning": "rpm"
  }, {
    "matchDatasources": ["rpm"],
    "matchPackageNames": ["rpm-sign"],
    "registryUrls": ["https://repo.almalinux.org/almalinux/9/BaseOS/x86_64/os/repodata/"],
    "versioning": "rpm"
  }, {
    "matchDatasources": ["rpm"],
    "matchPackageNames": ["createrepo_c"],
    "registryUrls": ["https://repo.almalinux.org/almalinux/9/AppStream/x86_64/os/repodata/"],
    "versioning": "rpm"
  }],
  "customManagers": [{
    "customType": "regex",
    "managerFilePatterns": ["/^justfile$/"],
    "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\w+ := \"(?<currentValue>[^\"]+)\""]
  }]
}
